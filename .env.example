PORT=3000

# Admin login (flat session auth — see .claude/CLAUDE.md's Session auth section)
ADMIN_USER=admin
ADMIN_PASS=
SESSION_SECRET=replace-this-in-prod

# AWS
AWS_REGION=us-east-2
AWS_S3_BUCKET=
# Deploy-only: where deploy.yml stages backend.zip and the private .env — not
# read by the running app itself. See docs/ARCHITECTURE.md's Deploy flow.
AWS_BACKEND_BUCKET=

# DynamoDB — one table per content type, see docs/DATA-MODEL.md
AWS_ROUNDTABLES_TABLE=
AWS_INITIATIVES_TABLE=
AWS_POSTS_TABLE=
AWS_IMAGES_TABLE=
AWS_PRESS_TABLE=
AWS_INVESTMENTS_TABLE=
AWS_EVENTS_TABLE=
AWS_SETTINGS_TABLE=
AWS_SESSIONS_TABLE=
AWS_USERS_TABLE=
# Legacy: the original single-table survey-responses store (db/dynamoClient.js,
# routes/survey-responses.js), predates the Repository-based tables above.
AWS_DYNAMODB_TABLE=

# Sentry
SENTRY_DSN=
SENTRY_BROWSER_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=purpose-investor-network@latest
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_BROWSER_TRACES_SAMPLE_RATE=0.0

# Analytics
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# Email (SES) — both must be set for notification emails to send
NOTIFY_EMAIL=
SES_FROM_EMAIL=

# Public-facing site URL — used to build absolute links in emails (invites,
# password resets). Can't be derived from the request; see shared/config.js.
SITE_URL=
